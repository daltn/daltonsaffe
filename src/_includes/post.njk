---
layout: base.njk
ogType: article
---
<article class="post">
  <header>
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
  </header>
  {%- if cover %}
  {% img cover, coverAlt or title, "(min-width: 800px) 640px, 100vw", "post-cover", false %}
  {%- endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  <footer>
    <a href="/journal/">← journal</a>
  </footer>
</article>
