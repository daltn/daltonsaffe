<form name="email-list" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="email-form">
  <input type="hidden" name="form-name" value="email-list" />
  <p hidden><label>leave empty <input name="bot-field" /></label></p>
  <input type="email" name="email" placeholder="your email" aria-label="your email" required />
  <button type="submit">subscribe</button>
</form>
