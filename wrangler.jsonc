// Cloudflare Workers config: serves the built site in _site/ as static files.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daltonsaffe",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    // /about -> /about/, and serves about/index.html
    "html_handling": "auto-trailing-slash",
    // unknown URLs get _site/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
